# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8869436623:AAEEIv8WGOAO3j_OxWplqXvRynDVN7wgnI4

# Public HTTPS URL where this backend is reachable by Telegram servers.
# Example (ngrok for local dev): https://abc123.ngrok-free.app
# Example (production):          https://api.ruangtutor.id
WEBHOOK_URL=https://your-public-domain.example.com

# ── Langflow ──────────────────────────────────────────────────────────────────
