# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Public HTTPS URL where this backend is reachable by Telegram servers.
# Local dev example: https://abc123.ngrok-free.app
# Production example: https://api.ruangtutor.id
WEBHOOK_URL=https://your-public-domain.example.com

# ── Langflow ──────────────────────────────────────────────────────────────────
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=741990f6-cf6e-4039-bcb6-1bf774dd91d7
LANGFLOW_API_URL=http://127.0.0.1:7860/api/v1/run/741990f6-cf6e-4039-bcb6-1bf774dd91d7
LANGFLOW_API_KEY=YOUR_LANGFLOW_API_KEY_HERE
LANGFLOW_USERNAME=
LANGFLOW_PASSWORD=

# ── Astra DB ──────────────────────────────────────────────────────────────────
ASTRA_DB_TOKEN=YOUR_ASTRA_DB_TOKEN_HERE
ASTRA_DB_ENDPOINT=YOUR_ASTRA_DB_ENDPOINT_HERE
ASTRA_DB_COLLECTION=vector_materi_jarkom

# ── Google / Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
USE_GOOGLE_VISION=false
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ── OCR ───────────────────────────────────────────────────────────────────────
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
