USE_GOOGLE_VISION=false
# Path to your Google service-account JSON (only needed when USE_GOOGLE_VISION=true)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
